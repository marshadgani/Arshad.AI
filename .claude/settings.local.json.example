{
  "_comment": "Personal Claude Code settings overlay — gitignored. Copy to settings.local.json and edit. Anything here overrides .claude/settings.json for this machine only.",

  "model": "claude-sonnet-4-6",

  "env": {
    "_comment": "Personal env vars Claude reads at session start.",
    "EDITOR": "code"
  },

  "permissions": {
    "_comment": "Bash + MCP allowlist. Each entry skips the permission prompt for that command. Be conservative: a command in `allow` runs without confirmation. Trim the list to what you actually use on THIS machine.",

    "allow": [
      "// ── Git: read-only ──────────────────────────────────────────────",
      "Bash(git status)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git remote:*)",
      "Bash(git rev-parse:*)",
      "Bash(git ls-tree:*)",
      "Bash(git ls-remote:*)",
      "Bash(git for-each-ref:*)",
      "Bash(git rev-list:*)",
      "Bash(git fetch:*)",

      "// ── Git: safe writes (still prompt on push --force, see deny below) ──",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git restore:*)",
      "Bash(git stash:*)",
      "Bash(git pull:*)",
      "Bash(git push origin:*)",
      "Bash(git push -u origin:*)",
      "Bash(git config core.hooksPath:*)",

      "// ── Filesystem read ─────────────────────────────────────────────",
      "Bash(ls:*)",
      "Bash(pwd)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(file:*)",
      "Bash(stat:*)",
      "Bash(which:*)",
      "Bash(tree:*)",

      "// ── Backend: Python / FastAPI ──────────────────────────────────",
      "Bash(python3 -c:*)",
      "Bash(python3 -m py_compile:*)",
      "Bash(python3 -m pytest:*)",
      "Bash(python3 -m json.tool:*)",
      "Bash(pytest:*)",
      "Bash(pip install:*)",
      "Bash(pip list:*)",
      "Bash(pip show:*)",
      "Bash(uvicorn:*)",
      "Bash(alembic:*)",
      "Bash(ruff check:*)",
      "Bash(ruff format:*)",

      "// ── Frontend: Node / Vite ──────────────────────────────────────",
      "Bash(npm install)",
      "Bash(npm install:*)",
      "Bash(npm ci)",
      "Bash(npm ci:*)",
      "Bash(npm run:*)",
      "Bash(npm test:*)",
      "Bash(npx tsc:*)",
      "Bash(npx eslint:*)",
      "Bash(npx prettier:*)",
      "Bash(npx vitest:*)",
      "Bash(npx vite:*)",

      "// ── Docker / Compose ────────────────────────────────────────────",
      "Bash(docker ps:*)",
      "Bash(docker images:*)",
      "Bash(docker logs:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(docker compose config:*)",
      "Bash(docker compose build:*)",
      "Bash(docker compose up:*)",
      "Bash(docker compose down:*)",
      "Bash(docker compose restart:*)",
      "Bash(docker compose exec:*)",

      "// ── Shell / project scripts ─────────────────────────────────────",
      "Bash(bash -n:*)",
      "Bash(bash scripts/:*)",
      "Bash(./scripts/:*)",
      "Bash(./.claude/hooks/:*)",
      "Bash(make:*)",
      "Bash(echo:*)",
      "Bash(printf:*)",
      "Bash(test:*)",
      "Bash(\\[ :*)",

      "// ── Filesystem write (bounded) ──────────────────────────────────",
      "Bash(mkdir -p:*)",
      "Bash(touch:*)",
      "Bash(chmod +x:*)",
      "Bash(chmod 644:*)",
      "Bash(chmod 755:*)",

      "// ── MCP: GitHub read-only (no-op until GitHub MCP is configured) ──",
      "mcp__github__search_pull_requests",
      "mcp__github__search_issues",
      "mcp__github__list_pull_requests",
      "mcp__github__list_issues",
      "mcp__github__get_pull_request",
      "mcp__github__get_issue",
      "mcp__github__get_file_contents",
      "mcp__github__list_branches",
      "mcp__github__list_commits"
    ],

    "deny": [
      "// ── Always refuse, even if a parent pattern would allow ──",
      "Bash(rm -rf /:*)",
      "Bash(rm -rf ~:*)",
      "Bash(rm -rf $HOME:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -f:*)",
      "Bash(git branch -D:*)",
      "Bash(curl:* | sh)",
      "Bash(curl:* | bash)",
      "Bash(wget:* | sh)",
      "Bash(wget:* | bash)",
      "Bash(sudo:*)"
    ],

    "_notes": [
      "Patterns: 'Bash(cmd)' = exact match. 'Bash(cmd:*)' = prefix match.",
      "deny wins over allow. Anything not matched falls through to a normal prompt.",
      "The bash-guard.sh PreToolUse hook is a second line of defence — it runs even on Bash calls in this allow list.",
      "Lines starting with // are comments — Claude Code ignores entries that don't parse as 'Tool(...)' or 'mcp__server__tool'.",
      "Add to `allow` only after running a command and verifying it does what you expect on THIS machine."
    ]
  }
}
