{
  "model": "claude-sonnet-4-6",
  "memory": "project",
  "hooks": {
    "pre-commit": ".claude/hooks/pre-commit.sh",
    "on-save": ".claude/hooks/lint-on-save.sh"
  },
  "rules": [
    ".claude/rules/frontend.md",
    ".claude/rules/database.md",
    ".claude/rules/api.md"
  ],
  "agents": {
    "directory": ".claude/agents"
  },
  "commands": {
    "directory": ".claude/commands"
  },
  "modelStrategy": {
    "planning": "claude-opus-4-7",
    "execution": "claude-sonnet-4-6",
    "note": "Use the planner agent (Opus) for any non-trivial task before writing code. All prompts and all other agents run on Sonnet."
  }
}
