# Absolute origin of the backend API, used ONLY for the OAuth login
# top-level navigation (frontend/src/auth/oauthLoginUrl.ts). This must be an
# absolute origin, not a relative path: the OAuth provider's callback
# redirects the browser directly to the backend's own domain, so the login
# navigation must originate there too, or the backend's oauth_login_nonce
# cookie ends up scoped to the wrong registrable domain and every login
# fails with invalid_state.
#
# Local dev: leave empty. The code falls back to http://localhost:8000.
#
# Production (Vercel): set this to the exact Render backend origin,
# e.g. https://arshad-ai.onrender.com — it must match BACKEND_URL on Render
# byte-for-byte (scheme + host, no trailing slash).
#
# IMPORTANT: this value is inlined into the JS bundle at BUILD time. Changing
# it in the Vercel dashboard has no effect until you trigger a rebuild.
VITE_API_BASE_URL=
