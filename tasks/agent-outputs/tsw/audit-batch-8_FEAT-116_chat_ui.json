    {"test_id":"TC-116-02","name":"Loading state","input":"sessionId not yet set","expected":"Renders 'Creating chat…'"},
    {"test_id":"TC-116-03","name":"useChatStream sends bearer","input":"send('hello')","expected":"fetch with Authorization: Bearer <token>; Accept: text/event-stream"},
    {"test_id":"TC-116-04","name":"Token absent","input":"getToken()=null","expected":"state.error='401 Unauthorized'; no fetch issued"},
    {"test_id":"TC-116-05","name":"Multiple deltas concat","input":"3 delta events","expected":"assistantText is concatenation of all 3"},
    {"test_id":"TC-116-06","name":"intent event","input":"server sends {intent:'calendar'}","expected":"state.intent='calendar'"},
    {"test_id":"TC-116-07","name":"tool_use event","input":"server sends {tool_use:{id,name,input}}","expected":"toolCalls appended with status='running'"},
    {"test_id":"TC-116-08","name":"tool_result mapping","input":"matches existing tool_use by id","expected":"That entry's status flips to 'completed' (or 'error' if is_error); output set"},
    {"test_id":"TC-116-09","name":"[DONE] terminator","input":"server sends data: [DONE]","expected":"isStreaming=false; loop exits"},
    {"test_id":"TC-116-10","name":"Malformed JSON line","input":"data: not-json","expected":"continue silently; no crash"},
    {"test_id":"TC-116-11","name":"AbortController cancellation","input":"send() called twice in quick succession","expected":"First abort()'d; only second's stream applies"},
    {"test_id":"TC-116-12","name":"Network error","input":"fetch throws non-AbortError","expected":"state.error set; isStreaming=false"}
