# Required — startup will fail if any of these are unset or use the placeholder values.

# DB connection (Docker: host=postgres; local: host=localhost)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/arshad_ai

# Supabase: set this to the *direct* connection URL (port 5432) so both the
# application engine AND Alembic migrations bypass the transaction pooler
# (Supavisor port 6543), which is incompatible with asyncpg's prepared
# statement protocol and causes DuplicatePreparedStatementError at startup.
# Example: postgresql+asyncpg://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
# Leave blank on local/Docker — falls back to DATABASE_URL automatically.
DATABASE_URL_DIRECT=

# Redis connection (Docker: host=redis; local: host=localhost)
REDIS_URL=redis://redis:6379

# Generate a fresh value with: python -c 'import secrets; print(secrets.token_urlsafe(32))'
# The literal string 'change-me' is rejected at startup.
SECRET_KEY=change-me

# Anthropic API key for Claude tool calls.
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Comma-separated list of allowed CORS origins. Defaults to http://localhost:3000 if unset.
CORS_ORIGINS=http://localhost:3000

# ───── Phase C — OAuth + JWT ─────

# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web)
# Authorized redirect URIs must include: <BACKEND_URL>/api/v1/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret

# https://github.com/settings/developers → OAuth Apps → New OAuth App
# Authorization callback URL must be: <BACKEND_URL>/api/v1/auth/github/callback
GITHUB_OAUTH_CLIENT_ID=your-github-client-id
GITHUB_OAUTH_CLIENT_SECRET=your-github-client-secret

# ── Phase H integration OAuth apps ──────────────────────────────────────
# Each provider needs an OAuth app registered in its developer console with
# the redirect URI:
#   <BACKEND_URL>/api/v1/integrations/oauth/<slug>/callback
# Skip any you don't plan to use — connect() will surface a clear missing-key
# error in the Integrations UI.

# https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# https://cloud.ouraring.com/oauth/applications
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=

# https://dev.fitbit.com/apps
FITBIT_CLIENT_ID=
FITBIT_CLIENT_SECRET=

# https://www.coinbase.com/oauth/applications
COINBASE_CLIENT_ID=
COINBASE_CLIENT_SECRET=

# https://discord.com/developers/applications → New Application → OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# https://www.reddit.com/prefs/apps → "create another app" → web app
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# https://linear.app/settings/api/applications/new
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=

# https://upstox.com/developer/api-documentation/open-api
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=

# Kite Connect (paid ₹2000/mo) — https://developers.kite.trade
ZERODHA_KITE_CLIENT_ID=
ZERODHA_KITE_CLIENT_SECRET=

# Plaid (US banking) — https://dashboard.plaid.com/signup
# PLAID_ENV: sandbox | development | production
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# 32-byte URL-safe base64 key. Generate ONCE per environment with:
#   python3 -c "import secrets, base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# Rotating this without re-encrypting stored tokens will lock all users out.
OAUTH_ENCRYPTION_KEY=your-32-byte-urlsafe-base64-key

# JWT issuance — signed with SECRET_KEY (HS256), 24h default expiry.
JWT_EXPIRY_HOURS=24

# Public-facing URLs used to construct OAuth redirect URIs and post-login redirects.
# Local: http://localhost:8000 / http://localhost:3000
# Prod:  https://<render-backend>.onrender.com / https://<vercel-app>.vercel.app
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# ───── Phase F — Ingestion DAGs + Queue Worker ─────

# Set 'true' on Render (no Airflow) to start the in-process queue worker
# alongside FastAPI. In docker-compose dev, leave 'false' — Airflow handles
# the queue. SELECT...FOR UPDATE SKIP LOCKED makes both-running safe even
# if misconfigured (just wasteful).
ENABLE_INPROCESS_WORKER=false

# Polling interval for the in-process worker (seconds). Default 5.
QUEUE_POLL_INTERVAL_SECONDS=5

# Per-DAG row limit per ingestion run. Caps memory + provider quota.
MAX_INGEST_BATCH_SIZE=100

# ───── Obsidian vault sync ─────

# Private GitHub repo that acts as the Obsidian vault bridge.
# Install the "Obsidian Git" community plugin and point it at this repo.
# Format: owner/repo-name  (e.g. marshadgani/obsidian-vault)
# Uses the user's linked GitHub OAuth token — no separate PAT needed.
OBSIDIAN_GITHUB_REPO=

# ───── Phase B — Chat ─────

# Anthropic model used for both stage-1 (intent) and stage-2 (response).
ANTHROPIC_MODEL_DEFAULT=claude-haiku-4-5-20251001

# Max output tokens per chat turn.
CHAT_MAX_TOKENS=2048

# Max input-history tokens before chat.py drops oldest user/assistant pairs.
CHAT_HISTORY_TOKEN_BUDGET=8000
