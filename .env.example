# Root-level env file — used by docker-compose for variable substitution.
# Copy this file to `.env` (gitignored) before running `docker compose up`.
# These are LOCAL-DEV-ONLY defaults. Generate fresh values before any non-local deploy.

# Postgres credentials. Picked up by both the postgres service and the
# AIRFLOW__DATABASE__SQL_ALCHEMY_CONN connection string.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme-local-dev
POSTGRES_DB=arshad_ai

# Airflow webserver session secret. Generate with:
#   python -c 'import secrets; print(secrets.token_urlsafe(32))'
AIRFLOW_SECRET_KEY=changeme-local-airflow-secret

# Airflow admin user — created on first boot of the airflow service.
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=changeme-local-airflow-password
